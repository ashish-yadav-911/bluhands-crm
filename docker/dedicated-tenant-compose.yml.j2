{# Per-tenant ERPNext + MariaDB stack, following the frappe_docker reference
   topology (https://github.com/frappe/frappe_docker), flattened into one
   self-contained file per tenant for v1 simplicity. #}
name: {{ compose_project_name }}

x-erpnext-image: &erpnext_image frappe/erpnext:{{ image_version }}

services:
  mariadb:
    image: mariadb:10.6
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: {{ mariadb_root_password }}
    command:
      - --character-set-server=utf8mb4
      - --collation-server=utf8mb4_unicode_ci
      - --skip-character-set-client-handshake
      - --skip-innodb-read-only-compressed
    volumes:
      - mariadb-data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 10

  redis-cache:
    image: redis:6.2-alpine
    restart: unless-stopped

  redis-queue:
    image: redis:6.2-alpine
    restart: unless-stopped
    volumes:
      - redis-queue-data:/data

  configurator:
    image: *erpnext_image
    restart: "no"
    entrypoint: ["bash", "-c"]
    # Frappe reads db/redis connection details from sites/common_site_config.json,
    # not from these env vars directly -- this one-shot step is what writes
    # them there. Every other service depends on it completing first.
    command:
      - >
        ls -1 apps > sites/apps.txt;
        bench set-config -g db_host $$DB_HOST;
        bench set-config -gp db_port $$DB_PORT;
        bench set-config -g redis_cache "redis://$$REDIS_CACHE";
        bench set-config -g redis_queue "redis://$$REDIS_QUEUE";
        bench set-config -g redis_socketio "redis://$$REDIS_QUEUE";
        bench set-config -gp socketio_port $$SOCKETIO_PORT;
    environment:
      DB_HOST: mariadb
      DB_PORT: "3306"
      REDIS_CACHE: redis-cache:6379
      REDIS_QUEUE: redis-queue:6379
      SOCKETIO_PORT: "9000"
    volumes:
      - sites:/home/frappe/frappe-bench/sites
    depends_on:
      mariadb:
        condition: service_healthy

  backend: &backend_service
    image: *erpnext_image
    restart: unless-stopped
    environment:
      DB_HOST: mariadb
      DB_PORT: "3306"
      REDIS_CACHE: redis-cache:6379
      REDIS_QUEUE: redis-queue:6379
      SOCKETIO_PORT: "9000"
    volumes:
      - sites:/home/frappe/frappe-bench/sites
      - logs:/home/frappe/frappe-bench/logs
    depends_on:
      mariadb:
        condition: service_healthy
      configurator:
        condition: service_completed_successfully
    # No HTTP healthcheck here: /api/method/ping 404s for any Host it
    # doesn't recognize, and no site exists until bench new-site runs
    # (which happens after this container is already up) -- an -f'd curl
    # healthcheck would deadlock waiting for a site that can't exist yet.

  websocket:
    <<: *backend_service
    command: ["node", "/home/frappe/frappe-bench/apps/frappe/socketio.js"]
    healthcheck:
      disable: true

  queue-short:
    <<: *backend_service
    command: ["bench", "worker", "--queue", "short,default"]
    healthcheck:
      disable: true

  queue-long:
    <<: *backend_service
    command: ["bench", "worker", "--queue", "long,default,short"]
    healthcheck:
      disable: true

  scheduler:
    <<: *backend_service
    command: ["bench", "schedule"]
    healthcheck:
      disable: true

  frontend:
    image: *erpnext_image
    command: ["nginx-entrypoint.sh"]
    restart: unless-stopped
    environment:
      BACKEND: backend:8000
      SOCKETIO: websocket:9000
      FRAPPE_SITE_NAME_HEADER: {{ site_name }}
      UPSTREAM_REAL_IP_ADDRESS: "127.0.0.1"
      UPSTREAM_REAL_IP_HEADER: "X-Forwarded-For"
      UPSTREAM_REAL_IP_RECURSIVE: "off"
      PROXY_READ_TIMEOUT: "120"
      CLIENT_MAX_BODY_SIZE: "50m"
    volumes:
      - sites:/usr/share/nginx/html/sites:ro
      - logs:/var/log/nginx
    ports:
      - "{{ http_port }}:8080"
    depends_on:
      - backend
      - websocket

volumes:
  mariadb-data:
  redis-queue-data:
  sites:
  logs:
