# Control-plane Postgres
DATABASE_URL=postgresql+psycopg://bluhands:bluhands@localhost:5432/bluhands_control

# Redis (Celery broker/result backend)
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Tenant provisioning
BASE_DOMAIN=tenants.localhost
TENANT_DATA_ROOT=./tenants_data
TENANT_PORT_RANGE_START=9000
TENANT_PORT_RANGE_END=9999
CADDY_SITES_DIR=./caddy/sites-enabled
CADDY_ADMIN_API=http://localhost:2019

# Agent job pipeline (Phase 2)
CUSTOM_APP_NAME=bluhands_custom
# stub = no-op placeholder (default, safe). openhands = real agent, runs in
# its own Docker image -- requires the settings below AND
# `docker build -t bluhands-agent-runner:latest docker/openhands-runner`.
AGENT_RUNNER=stub
AGENT_RUNNER_IMAGE=bluhands-agent-runner:latest
AGENT_JOB_TIMEOUT_SECONDS=1800

# LLM used by the OpenHands agent runner. Any OpenAI-compatible endpoint
# works via LLM_BASE_URL -- e.g. OpenRouter (https://openrouter.ai/api/v1)
# or a self-hosted Qwen server (e.g. http://host.docker.internal:8000/v1).
# LLM_MODEL must be prefixed "openai/" for a custom base_url per LiteLLM's
# convention, regardless of the model actually being served.
LLM_MODEL=openai/qwen2.5-coder-32b-instruct
LLM_API_KEY=
LLM_BASE_URL=

# --- Shared ERPNext bench (Phase 1) -------------------------------------
# ONE bench hosting many tenant sites, routed by Host header. Replaces the
# per-tenant compose stack; there is no per-tenant port in this mode.
SHARED_BENCH_PROJECT=bluhands-shared-bench
SHARED_BENCH_COMPOSE=docker/shared-bench-compose.yml
SHARED_BENCH_BACKEND_SERVICE=backend
SHARED_BENCH_HTTP_PORT=8080
# Required. bench new-site needs it; generate one and keep it stable, since
# every existing site's database was created against it.
SHARED_BENCH_DB_ROOT_PASSWORD=
